{
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "games/*"
  ],
  "scripts": {
    "dev": "node scripts/dev-game.mjs",
    "dev:site": "node scripts/build-site.mjs --serve",
    "preview": "node scripts/preview-site.mjs",
    "typecheck": "node scripts/typecheck-games.mjs",
    "test": "node --test tests/*.test.mjs",
    "validate:catalog": "node scripts/validate-catalog.mjs",
    "check:projects": "node scripts/check-projects.mjs",
    "validate:functions": "node scripts/validate-functions.mjs",
    "smoke:live": "node scripts/smoke-live.mjs",
    "check": "npm run typecheck && npm test && npm run validate:catalog && npm run validate:functions",
    "build": "npm run check && node scripts/build-site.mjs && npm run build:functions",
    "build:site": "node scripts/build-site.mjs",
    "build:functions": "node scripts/build-functions.mjs",
    "build:games": "node scripts/build-games.mjs",
    "new-game": "node scripts/new-game.mjs"
  },
  "dependencies": {
    "@netlify/blobs": "^11.1.0"
  },
  "devDependencies": {
    "@netlify/zip-it-and-ship-it": "16.2.0",
    "toml": "4.3.0",
    "typescript": "^5.7.0",
    "vite": "^6.1.0",
    "vite-plugin-top-level-await": "^1.4.4",
    "vite-plugin-wasm": "^3.4.1",
    "yaml": "^2.8.2"
  },
  "overrides": {
    "vite-plugin-top-level-await": {
      "uuid": "11.1.1"
    }
  }
}
